# 🚀 DEPLOYMENT FUNCTIONS
def deploy_pylance_optimization():
    """Deploy .pylanceignore to fix JavaScript heap memory issues"""
    try:
        with open('.pylanceignore', 'w', encoding='utf-8') as f:
            f.write(PYLANCEIGNORE_CONTENT.strip())
        print("✅ Deployed .pylanceignore - Pylance memory optimization active!")
        return True
    except Exception as e:
        print(f"⚠️  Error deploying Pylance optimization: {e}")
        return False

def deploy_tailwind_stack():
    """Deploy Tailwind CSS 4.1.13 + PostCSS configuration"""
    success = True
    
    try:
        with open('postcss.config.js', 'w', encoding='utf-8') as f:
            f.write(POSTCSS_CONFIG.strip())
        print("✅ Deployed postcss.config.js")
    except Exception as e:
        print(f"⚠️  Error deploying PostCSS config: {e}")
        success = False
    
    try:
        with open('tailwind.config.js', 'w', encoding='utf-8') as f:
            f.write(TAILWIND_CONFIG.strip())
        print("✅ Deployed tailwind.config.js with psycho-noir consciousness themes")
    except Exception as e:
        print(f"⚠️  Error deploying Tailwind config: {e}")
        success = False
    
    return success

def deploy_uv_package_management():
