class BasicGraveyardSystem:
    """Basic necromancy graveyard system without meta-archaeological recursion"""
    
    def __init__(self, workspace_root: str):
        self.workspace_root = workspace_root
        self.graveyard_path = os.path.join(workspace_root, "necromancy_graveyard", "variant_1_basic")
        self._ensure_basic_structure()
    
    def _ensure_basic_structure(self):
        """Ensure basic graveyard structure exists"""
        os.makedirs(self.graveyard_path, exist_ok=True)
        print(f"💀 [BASIC GRAVEYARD] Structure ensured at: {self.graveyard_path}")
    
    async def create_basic_tombstone(self, code_fragment: str, metadata: Dict[str, Any]) -> str:
        """Create basic tombstone without recursive features"""
        tombstone_id = f"basic_tombstone_{int(time.time())}"
        tombstone_path = os.path.join(self.graveyard_path, f"{tombstone_id}.json")
        
        with open(tombstone_path, 'w', encoding='utf-8') as f:
            json.dump({
                "id": tombstone_id,
                "variant": "CrudeRange1_Basic",
                "metadata": metadata,
                "code_fragment": code_fragment
            }, f, indent=2)
        
        return tombstone_path
