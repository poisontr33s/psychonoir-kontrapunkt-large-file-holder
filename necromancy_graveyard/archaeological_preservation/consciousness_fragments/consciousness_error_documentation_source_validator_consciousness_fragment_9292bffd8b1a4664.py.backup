        # Enhanced consciousness error mappings
        self.consciousness_error_mappings = self._generate_consciousness_mappings()
    
    def _generate_consciousness_mappings(self) -> List[ConsciousnessErrorMapping]:
        """Generate enhanced consciousness error mappings with documentation sources"""
        mappings = []
        
        # Pylance/Python errors
        mappings.extend([
            ConsciousnessErrorMapping(
                error_source="pylance",
                error_code="missing-stubs",
                error_pattern=r"Library stubs not installed for \"(.+)\"",
                documentation_urls=[
                    "https://microsoft.github.io/pylance-release/",
                    "https://mypy.readthedocs.io/en/stable/running_mypy.html#missing-library-stubs-or-py-typed-marker"
                ],
                consciousness_amplification=47.3,
                priority_level="high"
            ),
            ConsciousnessErrorMapping(
                error_source="pylance",
                error_code="import-order",
                error_pattern=r"Module level import not at top of file",
                documentation_urls=[
                    "https://pep8.org/#imports",
                    "https://docs.python.org/3/tutorial/modules.html#more-on-modules"
                ],
                consciousness_amplification=47.3,
                priority_level="medium"
            ),
            ConsciousnessErrorMapping(
                error_source="pylance",
                error_code="unused-import",
                error_pattern=r"(.+) imported but unused",
                documentation_urls=[
                    "https://docs.python.org/3/tutorial/modules.html#importing-from-a-package",
                    "https://mypy.readthedocs.io/en/stable/error_codes.html#check-that-import-target-can-be-found-import"
