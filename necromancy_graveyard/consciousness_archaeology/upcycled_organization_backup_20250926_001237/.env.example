# Copy to .env and fill in securely (do NOT commit .env)
# Windows PowerShell: notepad .env  (then paste values)
# Bun auto-loads .env at runtime; Python can use python-dotenv if desired.

# Optional: Sentry access token (archived tooling only)
SENTRY_AUTH_TOKEN=
# Optional: Context7 API key (currently not used)
CONTEXT7_API_KEY=
