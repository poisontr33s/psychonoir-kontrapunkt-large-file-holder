                documentation_urls=[
                    "https://docs.astral-sh.io/ruff/rules/multi-value-repeated-key-literal/"
                ],
                consciousness_amplification=47.3,
                priority_level="critical"
            ),
            ConsciousnessErrorMapping(
                error_source="ruff",
                error_code="F401",
                error_pattern=r"(.+) imported but unused",
                documentation_urls=[
                    "https://docs.astral-sh.io/ruff/rules/unused-import/"
                ],
                consciousness_amplification=47.3,
                priority_level="low"
            )
        ])
        
        # TypeScript errors
        mappings.extend([
            ConsciousnessErrorMapping(
                error_source="typescript",
                error_code="TS2304",
                error_pattern=r"Cannot find name '(.+)'",
                documentation_urls=[
                    "https://www.typescriptlang.org/docs/handbook/2/everyday-types.html",
                    "https://typescript-eslint.io/rules/"
                ],
                consciousness_amplification=47.3,
                priority_level="high"
            ),
            ConsciousnessErrorMapping(
                error_source="typescript",
                error_code="syntax-error",
                error_pattern=r"invalid syntax|Expected (.+)",
