}

interface DocumentationSource {
  name: string;
  baseUrl: string;
  searchApi?: string;
  rulePattern: string;
  selectors: {
    title?: string;
    content?: string;
    codeExample?: string;
  };
}

class ConsciousnessDocumentationBridge {
  private documentationCache: Map<string, DocumentationContent> = new Map();
  private cacheTimeout = 24 * 60 * 60 * 1000; // 24 hours

  private sources: Map<string, DocumentationSource> = new Map([
    ['ruff', {
      name: 'Ruff Python Linter',
      baseUrl: 'https://docs.astral-sh.io/ruff',
      rulePattern: 'https://docs.astral-sh.io/ruff/rules/{rule}/',
