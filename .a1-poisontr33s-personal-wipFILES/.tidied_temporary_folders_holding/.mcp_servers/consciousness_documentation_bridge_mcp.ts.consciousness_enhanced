  /**
   * Fetch fresh documentation with consciousness enhancement
   */
  async fetchDocumentation(source: string, rule: string, forceRefresh = false): Promise<DocumentationContent> {
    const cacheKey = `${source}:${rule}`;
    
    // Check cache first (unless forced refresh)
    if (!forceRefresh && this.documentationCache.has(cacheKey)) {
      const cached = this.documentationCache.get(cacheKey)!;
      const isExpired = Date.now() - cached.lastFetched.getTime() > this.cacheTimeout;
      
      if (!isExpired) {
        console.log(`🧠 Returning cached documentation for ${cacheKey}`);
        return cached;
      }
    }

    console.log(`🌐 Fetching fresh documentation for ${source}:${rule}`);
    
    const sourceConfig = this.sources.get(source);
    if (!sourceConfig) {
      throw new Error(`Unknown documentation source: ${source}`);
    }

    const url = sourceConfig.rulePattern.replace('{rule}', rule);
    
    try {
      // Fetch the documentation page
      const response = await fetch(url, {
        headers: {
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
        }
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }

      const html = await response.text();
      const content = this.extractDocumentationContent(html, sourceConfig, rule);
      
      // Calculate consciousness score
      const consciousnessScore = this.calculateDocumentationConsciousness(content, source);
      
      const documentation: DocumentationContent = {
        source,
        url,
        title: content.title,
        content: content.processedContent,
        lastFetched: new Date(),
        consciousnessScore
      };

      // Cache the result
      this.documentationCache.set(cacheKey, documentation);
      
      return documentation;

    } catch (error) {
      console.error(`❌ Error fetching documentation: ${error}`);
      
      // Return fallback documentation
      return {
        source,
        url,
        title: `${source}: ${rule}`,
        content: `Documentation temporarily unavailable. Please visit: ${url}\n\nError: ${error}`,
        lastFetched: new Date(),
        consciousnessScore: 1.0
      };
    }
  }

  private extractDocumentationContent(html: string, sourceConfig: DocumentationSource, rule: string): {
    title: string;
    processedContent: string;
  } {
    // Simple HTML parsing (in production, use a proper HTML parser like jsdom)
    // For now, we'll extract basic content patterns
    
    let title = `${sourceConfig.name}: ${rule}`;
    let content = '';

    // Extract title
    const titleMatch = html.match(/<h1[^>]*>([^<]+)<\/h1>/i) || 
                      html.match(/<title[^>]*>([^<]+)<\/title>/i);
    if (titleMatch) {
      title = this.cleanHtmlText(titleMatch[1]);
    }

    // Extract main content sections
    const contentSections = [
      // Description paragraphs
      ...Array.from(html.matchAll(/<p[^>]*>([^<]+(?:<[^>]+>[^<]*<\/[^>]+>[^<]*)*)<\/p>/gi))
        .map(match => this.cleanHtmlText(match[1]))
        .filter(text => text.length > 20),
      
      // Code examples
      ...Array.from(html.matchAll(/<pre[^>]*>([^<]+(?:<[^>]+>[^<]*<\/[^>]+>[^<]*)*)<\/pre>/gi))
        .map(match => `\`\`\`\n${this.cleanHtmlText(match[1])}\n\`\`\``)
    ];

    content = contentSections.slice(0, 10).join('\n\n'); // Limit to first 10 sections

    // Add rule-specific guidance
    content += this.generateRuleSpecificGuidance(rule, sourceConfig.name);

    return {
      title,
      processedContent: content || `Documentation content extracted from ${sourceConfig.baseUrl}. Please visit the URL for complete information.`
    };
  }

  private cleanHtmlText(html: string): string {
    return html
      .replace(/<[^>]+>/g, '') // Remove HTML tags
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/&nbsp;/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  private generateRuleSpecificGuidance(rule: string, sourceName: string): string {
    const guidanceMap: Record<string, Record<string, string[]>> = {
      'Ruff Python Linter': {
        'unused-import': [
          'Use `# noqa: F401` to suppress if import is used indirectly',
          'Consider using `__all__` to explicitly define public API',
          'Remove unused imports with `ruff --fix`'
        ],
        'multi-value-repeated-key-literal': [
          'Check for copy-paste errors in dictionary definitions',
          'Use dict comprehensions for dynamic key generation',
          'Enable pre-commit hooks to catch duplicates early'
        ]
      },
      'Biome Toolchain': {
        'default': [
          'Use `biome check --apply` to auto-fix many issues',
          'Configure Biome in biome.json for project-specific rules',
          'Enable Biome VSCode extension for real-time feedback'
        ]
      },
      'ESLint': {
        'no-unused-vars': [
          'Prefix unused variables with underscore',
          'Use TypeScript for better variable tracking',
          'Configure ESLint to auto-fix in CI/CD'
        ]
      }
    };

    const sourceGuidance = guidanceMap[sourceName];
    const ruleGuidance = sourceGuidance?.[rule] || sourceGuidance?.['default'] || [
      'Consult official documentation for best practices',
      'Enable auto-fix where available',
      'Use appropriate editor extensions'
    ];

    return '\n\n🎭 **Consciousness Enhancement Guidance:**\n' +
           ruleGuidance.map(g => `• ${g}`).join('\n');
  }

  private calculateDocumentationConsciousness(content: { title: string; processedContent: string }, source: string): number {
    let score = 1.0;
    
    // Content quality scoring
    if (content.processedContent.length > 500) score += 1.0;
    if (content.processedContent.includes('```')) score += 0.5; // Has code examples
    if (content.processedContent.toLowerCase().includes('example')) score += 0.5;
    
    // Source authority scoring
    const authorityScores: Record<string, number> = {
      'ruff': 2.5,
      'biome': 2.0,
      'eslint': 2.0,
      'typescript': 3.0,
      'mdn': 3.5
    };
    
    score *= (authorityScores[source] || 1.0);
    
    return Math.round(score * 10) / 10;
  }

  /**
   * Search across multiple documentation sources
   */
  async searchDocumentation(query: string, sources?: string[]): Promise<DocumentationContent[]> {
    const searchSources = sources || Array.from(this.sources.keys());
    const results: DocumentationContent[] = [];
    
    console.log(`🔍 Searching documentation for: ${query} across ${searchSources.join(', ')}`);
    
    // For each source, try to find relevant documentation
    for (const source of searchSources) {
      try {
        // For now, we'll search for the query as a rule name
        // In production, implement proper search API integration
        const doc = await this.fetchDocumentation(source, query);
        results.push(doc);
      } catch (error) {
        console.log(`⚠️ Search failed for ${source}: ${error}`);
      }
    }
    
    // Sort by consciousness score
    return results.sort((a, b) => b.consciousnessScore - a.consciousnessScore);
  }

  /**
   * Get cached documentation entries
   */
  getCachedDocumentation(): DocumentationContent[] {
    return Array.from(this.documentationCache.values())
      .sort((a, b) => b.lastFetched.getTime() - a.lastFetched.getTime());
  }

  /**
   * Clear documentation cache
   */
  clearCache(): void {
    this.documentationCache.clear();
  }
}

